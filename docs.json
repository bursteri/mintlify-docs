{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Plainrouter",
  "description": "Configure privacy-safe first-party Signals, connect account-bound AI agents, and govern Meta advertising changes with explicit policy, approval, and verification.",
  "seo": {
    "metatags": {
      "canonical": "https://plainrouter.com/docs"
    }
  },
  "rounded": "sharp",
  "colors": {
    "primary": "#171717",
    "light": "#FAFAFA",
    "dark": "#171717"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "billing/overview",
              "sandbox"
            ]
          },
          {
            "group": "Signals",
            "icon": "radio",
            "pages": [
              "signals/overview",
              "signals/configure-dns",
              "signals/install-pixel",
              "signals/configure-serving",
              "signals/verify-ingestion",
              "signals/track-events",
              "signals/connect-meta",
              "signals/health-and-performance"
            ]
          },
          {
            "group": "Actions",
            "icon": "workflow",
            "pages": [
              "actions/overview",
              "actions/creative-workflow",
              "actions/review-proposals",
              "actions/policies-and-safety",
              "actions/audit-log"
            ]
          },
          {
            "group": "Reference",
            "icon": "library",
            "pages": [
              "auth",
              "reference/api-resource-index",
              "reference/api-catalog",
              "reference/statuses-and-terms"
            ]
          },
          {
            "group": "Legacy Launcher",
            "icon": "archive",
            "pages": [
              "launcher/connect-drive",
              "launcher/import-draft-batch"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "plug",
        "groups": [
          {
            "group": "Overview",
            "icon": "plug",
            "pages": [
              "mcp/overview",
              "actions/connect-agent"
            ]
          },
          {
            "group": "Access",
            "icon": "key-round",
            "pages": [
              "actions/workspace-tokens"
            ]
          },
          {
            "group": "Reference",
            "icon": "library",
            "pages": [
              "reference/mcp-tools"
            ]
          }
        ]
      },
      {
        "tab": "SDK & CLI",
        "icon": "terminal",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "sdk/overview"
            ]
          },
          {
            "group": "TypeScript SDK",
            "icon": "code",
            "pages": [
              "sdk/typescript",
              "guides/meta-capi/nodejs"
            ]
          },
          {
            "group": "Python SDK",
            "icon": "code",
            "pages": [
              "sdk/python"
            ]
          },
          {
            "group": "Ruby SDK",
            "icon": "code",
            "pages": [
              "sdk/ruby"
            ]
          },
          {
            "group": "Go SDK",
            "icon": "code",
            "pages": [
              "sdk/go"
            ]
          },
          {
            "group": "CLI",
            "icon": "terminal",
            "pages": [
              "cli/quickstart",
              "cli/commands"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "braces",
        "openapi": "https://plainrouter.com/openapi.json",
        "pages": [
          "reference/conversion-api",
          "GET /sandbox",
          "GET /sandbox/keys",
          "POST /sandbox/keys",
          "POST /sandbox/events",
          "POST /sandbox/keyed-events",
          "api-reference/event/submit-a-conversion-event",
          "POST /verification-events",
          "GET /events/{event}",
          "GET /dashboard/events",
          "GET /dashboard/events/cursor",
          "PATCH /destinations/{destination}/test-mode",
          "POST /destinations/{destination}/test-purchase",
          "POST /deliveries/replay",
          "GET /reports/reconciliation",
          "GET /reports/emq",
          "DELETE /user-data"
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "groups": [
          {
            "group": "2026",
            "icon": "calendar-days",
            "pages": [
              "changelog/2026-09",
              "changelog/2026-08"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Homepage",
          "href": "https://plainrouter.com",
          "icon": "house"
        },
        {
          "anchor": "Agent repository",
          "href": "https://github.com/plainrouter/sdk",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://plainrouter.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://plainrouter.com/login"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/wudaku",
      "linkedin": "https://www.linkedin.com/company/plainrouter/"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
