{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PlainRouter",
  "description": "Configure privacy-safe first-party Signals, connect account-bound AI agents, and govern Meta advertising changes with explicit policy, approval, and verification.",
  "rounded": "sharp",
  "colors": {
    "primary": "#FF5722",
    "light": "#FF8A65",
    "dark": "#000000"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "sandbox"
            ]
          },
          {
            "group": "Signals",
            "pages": [
              "signals/overview",
              "signals/configure-dns",
              "signals/verify-ingestion",
              "signals/configure-serving",
              "signals/install-pixel",
              "signals/track-events",
              "signals/connect-meta",
              "signals/health-and-performance"
            ]
          },
          {
            "group": "Launcher",
            "pages": [
              "launcher/connect-drive"
            ]
          },
          {
            "group": "Actions",
            "pages": [
              "actions/overview",
              "actions/creative-workflow",
              "actions/review-proposals",
              "actions/policies-and-safety",
              "actions/audit-log"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "auth",
              "reference/api-resource-index",
              "reference/api-catalog",
              "reference/statuses-and-terms"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "groups": [
          {
            "group": "Connect",
            "pages": [
              "actions/connect-agent",
              "actions/workspace-tokens"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/mcp-tools",
              "launcher/import-draft-batch"
            ]
          }
        ]
      },
      {
        "tab": "SDK & CLI",
        "groups": [
          {
            "group": "TypeScript SDK",
            "pages": [
              "sdk/typescript"
            ]
          },
          {
            "group": "Python SDK",
            "pages": [
              "sdk/python"
            ]
          },
          {
            "group": "CLI",
            "pages": [
              "cli/quickstart",
              "cli/commands"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "https://plainrouter.com/openapi.json",
        "pages": [
          "reference/conversion-api",
          "GET /sandbox",
          "GET /sandbox/keys",
          "POST /sandbox/keys",
          "POST /sandbox/events",
          "POST /sandbox/keyed-events",
          "POST /events",
          "POST /verification-events",
          "GET /events/{event}",
          "GET /dashboard/events",
          "PATCH /destinations/{destination}/test-mode",
          "POST /destinations/{destination}/test-purchase",
          "POST /deliveries/replay",
          "GET /reports/reconciliation",
          "GET /reports/emq",
          "DELETE /user-data"
        ]
      },
      {
        "tab": "Changelog",
        "groups": [
          {
            "group": "2026",
            "pages": [
              "changelog/2026-08"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Homepage",
          "href": "https://plainrouter.com",
          "icon": "house"
        },
        {
          "anchor": "Agent repository",
          "href": "https://github.com/wudaku/plainrouter-sdk",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://plainrouter.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://plainrouter.com/dashboard"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/wudaku",
      "linkedin": "https://www.linkedin.com/company/ivyandion"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "redirects": [
    {
      "source": "/reference/authentication",
      "destination": "/auth"
    }
  ]
}
