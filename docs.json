{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Plainrouter",
  "description": "Configure privacy-safe first-party Signals, connect account-bound AI agents, and govern Meta advertising changes with explicit policy, approval, and verification.",
  "seo": {
    "metatags": {
      "canonical": "https://plainrouter.com/docs"
    }
  },
  "rounded": "sharp",
  "colors": {
    "primary": "#171717",
    "light": "#FAFAFA",
    "dark": "#171717"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "fonts": {
    "family": "Geist"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "index",
              "quickstart",
              "billing/overview"
            ]
          },
          {
            "group": "Signals",
            "icon": "radio",
            "pages": [
              "signals/overview",
              "signals/configure-dns",
              "signals/install-pixel",
              "signals/configure-serving",
              "signals/verify-ingestion",
              "signals/track-events",
              "signals/connect-meta",
              "signals/health-and-performance"
            ]
          },
          {
            "group": "Actions",
            "icon": "workflow",
            "pages": [
              "actions/overview",
              "actions/creative-workflow",
              "actions/review-proposals",
              "actions/policies-and-safety",
              "actions/audit-log"
            ]
          },
          {
            "group": "Reference",
            "icon": "library",
            "pages": [
              "reference/statuses-and-terms"
            ]
          },
          {
            "group": "Legacy Launcher",
            "icon": "archive",
            "pages": [
              "launcher/connect-drive",
              "launcher/import-draft-batch"
            ]
          }
        ]
      },
      {
        "tab": "MCP",
        "icon": "plug",
        "groups": [
          {
            "group": "Overview",
            "icon": "plug",
            "pages": [
              "mcp/overview",
              "mcp/setup"
            ]
          },
          {
            "group": "Access",
            "icon": "key-round",
            "pages": [
              "mcp/workspace-tokens"
            ]
          },
          {
            "group": "Reference",
            "icon": "library",
            "pages": [
              "mcp/tools"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "icon": "package",
        "groups": [
          {
            "group": "Overview",
            "icon": "book-open",
            "pages": [
              "sdk/overview"
            ]
          },
          {
            "group": "SDKs",
            "icon": "code",
            "pages": [
              "sdk/typescript",
              "sdk/python",
              "sdk/ruby",
              "sdk/go"
            ]
          },
          {
            "group": "Recipes",
            "icon": "send",
            "pages": [
              "sdk/recipes/meta-conversions"
            ]
          }
        ]
      },
      {
        "tab": "CLI",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Get started",
            "icon": "rocket",
            "pages": [
              "cli/get-started"
            ]
          },
          {
            "group": "Reference",
            "icon": "library",
            "pages": [
              "cli/command-reference"
            ]
          }
        ]
      },
      {
        "tab": "API",
        "icon": "code-xml",
        "groups": [
          {
            "group": "Overview",
            "icon": "book-open",
            "pages": [
              "api/introduction",
              "api/authentication",
              "api/sandbox",
              "api/conversions"
            ]
          },
          {
            "group": "Endpoints",
            "icon": "braces",
            "pages": [
              {
                "group": "Sandbox",
                "icon": "flask-conical",
                "pages": [
                  "api/sandbox/discover",
                  "api/sandbox/get-key",
                  "api/sandbox/create-key",
                  "api/sandbox/validate-event",
                  "api/sandbox/validate-keyed-event"
                ]
              },
              {
                "group": "Events",
                "icon": "send",
                "pages": [
                  "api/events/create",
                  "api/events/verify-ingestion",
                  "api/events/get",
                  "api/events/list",
                  "api/events/list-by-cursor"
                ]
              },
              {
                "group": "Destination testing",
                "icon": "test-tube-diagonal",
                "pages": [
                  "api/destinations/test-mode",
                  "api/destinations/test-purchase"
                ]
              },
              {
                "group": "Delivery replay",
                "icon": "rotate-cw",
                "pages": [
                  "api/deliveries/replay"
                ]
              },
              {
                "group": "Reports",
                "icon": "chart-no-axes-combined",
                "pages": [
                  "api/reports/reconciliation",
                  "api/reports/emq"
                ]
              },
              {
                "group": "Privacy",
                "icon": "shield",
                "pages": [
                  "api/privacy/delete-user-data"
                ]
              }
            ]
          },
          {
            "group": "Resources",
            "icon": "library",
            "pages": [
              "api/resources",
              "api/catalog"
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "list",
        "groups": [
          {
            "group": "2026",
            "icon": "calendar-days",
            "pages": [
              "changelog/2026-09",
              "changelog/2026-08"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Homepage",
          "href": "https://plainrouter.com",
          "icon": "house"
        },
        {
          "anchor": "Agent repository",
          "href": "https://github.com/plainrouter/sdk",
          "icon": "github"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://plainrouter.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://plainrouter.com/login"
