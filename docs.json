{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PlainRouter",
  "colors": {
    "primary": "#FF5722",
    "light": "#FF8A65",
    "dark": "#E64A19"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Signals",
        "pages": [
          "signals/overview",
          "signals/configure-dns",
          "signals/install-pixel",
          "signals/track-events",
          "signals/connect-meta",
          "signals/health-and-performance"
        ]
      },
      {
        "group": "Actions",
        "pages": [
          "actions/overview",
          "actions/connect-agent",
          "actions/review-proposals",
          "actions/policies-and-safety",
          "actions/audit-log"
        ]
      },
      {
        "group": "Agent reference",
        "pages": [
          "reference/mcp-tools",
          "reference/statuses-and-terms"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Homepage",
          "href": "https://plainrouter.com",
          "icon": "house"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://plainrouter.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://plainrouter.com/dashboard"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/ivyandion"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  }
}
