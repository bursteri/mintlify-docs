{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "PlainRouter",
  "colors": {
    "primary": "#FF5722",
    "light": "#FF8A65",
    "dark": "#E64A19"
  },
  "favicon": "/favicon.svg",
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "family": "Inter"
  },
  "icons": {
    "library": "lucide"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Signals",
        "pages": [
          "signals/configure-dns",
          "signals/install-pixel"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Homepage",
          "href": "https://plainrouter.com",
          "icon": "house"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://plainrouter.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://plainrouter.com/dashboard"
    }
  },
  "footer": {
    "socials": {
      "linkedin": "https://www.linkedin.com/company/ivyandion"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ]
  }
}
